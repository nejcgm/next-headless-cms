      "__component": "blocks.service-faq",
      "id": 400,
      "heading": "Frequently asked questions",
      "subheading": "Answers about our service",
      "items": [
        {
          "id": 401,
          "question": "How do I book a service?",
          "answer": "Call 070 815 379 or send an email. Describe the issue or the service you want, and we arrange bike drop-off. There are no fixed opening hours — appointments are always by agreement."
        },
        {
          "id": 402,
          "question": "Which bikes do you service?",
          "answer": "All of them: urban, road, gravel, mountain, and e-bikes (mechanical side). We have the most experience with MTB and trail, but we treat every type with the same care."
        },
        {
          "id": 403,
          "question": "How soon will the bike be ready?",
          "answer": "It depends on the scope and how busy we are. At drop-off we give an approximate date. Small urgent repairs are often quicker."
        },
        {
          "id": 404,
          "question": "Do I need a deposit?",
          "answer": "No. Payment on pickup. For more expensive parts we confirm with you first."
        },
        {
          "id": 405,
          "question": "Do you service e-bikes?",
          "answer": "Yes for the mechanical side. For batteries and motors we usually recommend the manufacturer service, except for straightforward jobs."
        }
      ],
      "contactCtaText": "Another question?",
      "contactCtaLabel": "Call or write",
      "contactCtaHref": "#kontakt"
