                      {
                        "__component": "blocks.text",
                        "id": 16,
                        "variant": "body",
                        "content": "From passion to workshop",
                        "bold": true,
                        "fontSize": "clamp(1.75rem, 3.2vw, 2.5rem)",
                        "color": "foreground"
                      },
                      {
                        "__component": "blocks.text",
                        "id": 17,
                        "variant": "body",
                        "content": "Vukan's Bike came out of a simple wish: that the region should have a place where you get a quality service, honest advice and a bike that is genuinely ready before you collect it.",
                        "color": "foreground"
                      },
                      {
                        "__component": "blocks.text",
                        "id": 18,
                        "variant": "body",
                        "content": "We work in Apače and service every type of bike — city, road, gravel, electric and mountain. Our longest experience is with mountain bikes: from a basic service to more demanding repairs and custom builds.",
                        "color": "foreground"
                      },
                      {
                        "__component": "blocks.text",
                        "id": 19,
                        "variant": "body",
                        "content": "No anonymous workshop. The same person inspects the bike, repairs it and hands it back — and tells you what was done and why.",
                        "color": "foreground"
                      }
                    ]
                  }
                },
                {
                  "__component": "blocks.image",
