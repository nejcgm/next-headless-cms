{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "string",
      "required": true
    },
    "lang": {
      "type": "string",
      "required": true,
      "default": "sl"
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "slugPattern": {
      "type": "string"
    },
    "template": {
      "type": "enumeration",
      "enum": [
        "default",
        "detail",
        "bare"
      ],
      "default": "default",
      "required": true
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.section",
        "blocks.stack",
        "blocks.flex",
        "blocks.grid",
        "blocks.heading",
        "blocks.text",
        "blocks.image",
        "blocks.button",
        "blocks.product-list",
        "blocks.bike-detail",
        "blocks.contact",
        "blocks.gallery",
        "blocks.partners-gallery",
        "blocks.service-pricing",
        "blocks.service-faq"
      ],
      "required": false
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true
    }
  }
}
