{
  "collectionName": "components_blocks_buttons",
  "info": {
    "displayName": "Button",
    "icon": "cursor",
    "description": "Button container (nests Icon and/or Text)"
  },
  "options": {},
  "attributes": {
    "adminName": {
      "type": "string"
    },
    "href": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "button",
        "submit",
        "reset"
      ],
      "default": "button"
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "primary",
        "secondary",
        "outline",
        "ghost"
      ],
      "default": "primary"
    },
    "width": {
      "type": "string"
    },
    "height": {
      "type": "string"
    },
    "padding": {
      "type": "string"
    },
    "margin": {
      "type": "string"
    },
    "fontSize": {
      "type": "integer"
    },
    "fontWeight": {
      "type": "integer"
    },
    "textAlign": {
      "type": "enumeration",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "backgroundColor": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "borderWidth": {
      "type": "integer"
    },
    "borderStyle": {
      "type": "enumeration",
      "enum": [
        "solid",
        "dashed",
        "dotted"
      ]
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "integer"
    },
    "overflow": {
      "type": "enumeration",
      "enum": [
        "visible",
        "hidden"
      ]
    },
    "accessibleLabel": {
      "type": "string"
    },
    "slots": {
      "type": "json",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    }
  }
}
