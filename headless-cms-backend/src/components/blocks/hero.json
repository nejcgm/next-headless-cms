{
  "collectionName": "components_blocks_heroes",
  "info": {
    "name": "Hero",
    "icon": "landscape",
    "displayName": "Hero",
    "description": "Full-viewport hero with headline, optional subheadline, background image, and CTA buttons"
  },
  "options": {},
  "attributes": {
    "headline": {
      "type": "string",
      "required": true
    },
    "subheadline": {
      "type": "string"
    },
    "backgroundImage": {
      "type": "string",
      "required": true
    },
    "backgroundFit": {
      "type": "enumeration",
      "enum": ["cover", "contain"],
      "default": "cover"
    },
    "overlay": {
      "type": "decimal",
      "default": 0.3
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-link",
      "required": true
    },
    "secondaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-link"
    }
  }
}
