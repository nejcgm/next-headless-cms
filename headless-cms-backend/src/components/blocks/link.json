    "minHeight": { "type": "string" },
    "maxWidth": { "type": "string" },
    "padding": { "type": "string" },
    "margin": { "type": "string" },
    "backgroundColor": { "type": "string" },
    "color": { "type": "string" },
    "border": { "type": "string" },
    "borderRadius": { "type": "string" },
    "overflow": {
      "type": "enumeration",
      "enum": ["visible", "hidden", "auto"]
    },
    "fontSize": { "type": "string" },
    "fontWeight": { "type": "string" },
    "textAlign": {
