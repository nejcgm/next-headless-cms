{
  "collectionName": "components_blocks_links",
  "info": {
    "displayName": "Link",
    "icon": "link",
    "description": "Text/icon link container (nests Icon and/or Text)"
  },
  "options": {},
  "attributes": {
    "adminName": {
      "type": "string"
    },
    "href": {
      "type": "string",
      "required": true
    },
    "target": {
      "type": "enumeration",
      "enum": [
        "_self",
        "_blank"
      ]
    },
    "variant": {
      "type": "enumeration",
      "enum": [
        "primary",
        "secondary",
        "ghost",
        "link"
      ],
      "default": "primary"
    },
    "showArrow": {
      "type": "boolean",
      "default": false
    },
    "fontSize": {
      "type": "integer"
    },
    "fontWeight": {
      "type": "integer"
    },
    "textAlign": {
      "type": "enumeration",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "color": {
      "type": "string"
    },
    "backgroundColor": {
      "type": "string"
    },
    "borderWidth": {
      "type": "integer"
    },
    "borderStyle": {
      "type": "enumeration",
      "enum": [
        "solid",
        "dashed",
        "dotted"
      ]
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "integer"
    },
    "padding": {
      "type": "string"
    },
    "accessibleLabel": {
      "type": "string"
    },
    "slots": {
      "type": "json",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    }
  }
}
