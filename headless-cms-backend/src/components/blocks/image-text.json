{
  "collectionName": "components_blocks_image_texts",
  "info": {
    "name": "ImageText",
    "icon": "layout",
    "displayName": "Image + Text",
    "description": "Two-column section with an image and text copy side by side"
  },
  "options": {},
  "attributes": {
    "layout": {
      "type": "enumeration",
      "enum": ["image-left", "image-right"],
      "default": "image-left"
    },
    "image": {
      "type": "component",
      "repeatable": false,
      "component": "shared.image-item",
      "required": true
    },
    "heading": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "text",
      "required": true
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-link"
    }
  }
}
