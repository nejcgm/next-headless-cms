{
  "collectionName": "components_blocks_sections",
  "info": {
    "displayName": "Section",
    "icon": "layout",
    "description": "Layout band with optional background; nesting via slots JSON"
  },
  "options": {},
  "attributes": {
    "adminName": {
      "type": "string"
    },
    "padding": {
      "type": "string"
    },
    "backgroundImage": {
      "type": "string"
    },
    "backgroundFit": {
      "type": "enumeration",
      "enum": [
        "cover",
        "contain"
      ],
      "default": "cover"
    },
    "backgroundPosition": {
      "type": "enumeration",
      "enum": [
        "center",
        "top",
        "bottom",
        "left",
        "right"
      ],
      "default": "center"
    },
    "overlay": {
      "type": "decimal",
      "min": 0,
      "max": 1
    },
    "anchorId": {
      "type": "string"
    },
    "surface": {
      "type": "enumeration",
      "enum": [
        "background",
        "muted",
        "accent",
        "foreground"
      ]
    },
    "minHeight": {
      "type": "enumeration",
      "enum": [
        "standard",
        "tall"
      ]
    },
    "width": {
      "type": "enumeration",
      "enum": [
        "full",
        "contained"
      ],
      "default": "contained"
    },
    "height": {
      "type": "string"
    },
    "maxWidth": {
      "type": "string"
    },
    "margin": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "borderWidth": {
      "type": "integer"
    },
    "borderStyle": {
      "type": "enumeration",
      "enum": [
        "solid",
        "dashed",
        "dotted"
      ]
    },
    "borderColor": {
      "type": "string"
    },
    "divider": {
      "type": "enumeration",
      "enum": [
        "none",
        "top",
        "bottom",
        "both"
      ],
      "default": "none"
    },
    "borderRadius": {
      "type": "string"
    },
    "overflow": {
      "type": "enumeration",
      "enum": [
        "visible",
        "hidden"
      ]
    },
    "slots": {
      "type": "json",
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    }
  }
}
