{
  "collectionName": "components_blocks_cta_banners",
  "info": {
    "name": "CtaBanner",
    "icon": "megaphone",
    "displayName": "CTA Banner",
    "description": "Full-width call-to-action strip with heading, optional subheading, and a single CTA"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "subheading": {
      "type": "string"
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-link",
      "required": true
    },
    "background": {
      "type": "enumeration",
      "enum": ["primary", "muted", "dark"],
      "default": "primary"
    }
  }
}
